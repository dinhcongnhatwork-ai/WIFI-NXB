# ===========================================
# WiFi Marketing Platform - Environment Config
# ===========================================

# Public domain and ports
APP_DOMAIN=solutionai.com.vn
FRONTEND_PORT=3000
BACKEND_PORT=3001
BACKEND_URL=http://127.0.0.1:3001

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:jtsc12345@192.168.1.90:5432/wifimarketing?schema=public"
JWT_SECRET="10122002"

# Redis
REDIS_URL="redis://localhost:6379"

# MinIO (S3-compatible storage)
MINIO_ENDPOINT="https://jtscminio.duckdns.org"
MINIO_PUBLIC_URL="https://jtscminio.duckdns.org"
MINIO_ACCESS_KEY=jtsc
MINIO_SECRET_KEY=jtsc12345
MINIO_BUCKET=wifimarketing

# JWT Authentication
# Mikrotik (optional)
# UniFi và MikroTik: thiết lập tại /admin/settings; không cần khai báo địa chỉ hoặc mật khẩu thiết bị trong .env.

# Next.js
NEXT_PUBLIC_APP_URL=https://solutionai.com.vn
NEXT_PUBLIC_API_URL=https://solutionai.com.vn
# Tên DNS của gateway Hotspot, khác với domain portal.
HOTSPOT_DNS_NAME=hotspot.wifi

# Device secrets encryption: generate once with npm run network:key; retain in backups.
NETWORK_CREDENTIALS_KEY=
# Monitoring stack uses a dedicated PostgreSQL database and Zabbix API token.
ZABBIX_API_URL=http://127.0.0.1:8088/api_jsonrpc.php
ZABBIX_API_TOKEN=
ZABBIX_DB_PASSWORD=
MONITOR_PROCESS_ENABLED=true
MONITOR_INTERVAL_MS=30000
MONITOR_SYSLOG_ALLOWED_HOSTS=

# Enable after configuring the UniFi external portal and LAN callback.
CAMPAIGN_HOTSPOT_ENABLED=false
UNIFI_PORTAL_SERVER=192.168.1.253
