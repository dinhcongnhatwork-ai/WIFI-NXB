'use client';

import { useState, useCallback, useRef } from 'react';
import type {
  TemplateConfig,
  TemplateElement,
  LogoElement,
  TitleElement,
  DescriptionElement,
  ImageElement,
  VideoElement,
  ConnectButtonElement,
  VideoGateElement,
} from '@/types';
import {
  GripVertical,
  Eye,
  EyeOff,
  Plus,
  Trash2,
  Image as ImageIcon,
  Type,
  FileText,
  Film,
  Wifi,
  PlayCircle,
  Upload,
  Monitor,
  Smartphone,
} from 'lucide-react';

interface Props {
  config: TemplateConfig;
  onSave: (config: TemplateConfig) => void;
}

const ELEMENT_LABELS: Record<string, string> = {
  logo: 'Logo',
  title: 'Tiêu đề',
  description: 'Mô tả',
  image: 'Hình ảnh',
  video: 'Video',
  connect_button: 'Nút kết nối',
  video_gate: 'Video Gate',
};

const ELEMENT_ICONS: Record<string, React.ReactNode> = {
  logo: <ImageIcon className="w-4 h-4" />,
  title: <Type className="w-4 h-4" />,
  description: <FileText className="w-4 h-4" />,
  image: <ImageIcon className="w-4 h-4" />,
  video: <Film className="w-4 h-4" />,
  connect_button: <Wifi className="w-4 h-4" />,
  video_gate: <PlayCircle className="w-4 h-4" />,
};

type TabId = 'background' | 'elements';

export default function PageBuilder({ config, onSave }: Props) {
  const [localConfig, setLocalConfig] = useState<TemplateConfig>(config);
  const [activeTab, setActiveTab] = useState<TabId>('elements');
  const [selectedElementId, setSelectedElementId] = useState<string | null>(null);
  const [previewMode, setPreviewMode] = useState<'mobile' | 'desktop'>('mobile');
  const [dragIndex, setDragIndex] = useState<number | null>(null);
  const [dragOverIndex, setDragOverIndex] = useState<number | null>(null);

  const updateConfig = useCallback((updater: (prev: TemplateConfig) => TemplateConfig) => {
    setLocalConfig(prev => updater(prev));
  }, []);

  const updateElement = useCallback((id: string, updates: Partial<TemplateElement>) => {
    updateConfig(prev => ({
      ...prev,
      elements: prev.elements.map(el =>
        el.id === id ? { ...el, ...updates } as TemplateElement : el
      ),
    }));
  }, [updateConfig]);

  const removeElement = useCallback((id: string) => {
    updateConfig(prev => ({
      ...prev,
      elements: prev.elements.filter(el => el.id !== id),
    }));
    setSelectedElementId(null);
  }, [updateConfig]);

  const toggleElement = useCallback((id: string) => {
    updateConfig(prev => ({
      ...prev,
      elements: prev.elements.map(el =>
        el.id === id ? { ...el, enabled: !el.enabled } as TemplateElement : el
      ),
    }));
  }, [updateConfig]);

  const addElement = useCallback((type: TemplateElement['type']) => {
    const id = `${type}-${Date.now()}`;
    let newElement: TemplateElement;
    switch (type) {
      case 'logo':
        newElement = { id, type: 'logo', enabled: true, src: '', width: '120px', position: 'center' };
        break;
      case 'title':
        newElement = { id, type: 'title', enabled: true, content: 'Tiêu đề mới', color: '#ffffff', fontSize: '24px', align: 'center' };
        break;
      case 'description':
        newElement = { id, type: 'description', enabled: true, content: 'Mô tả nội dung', color: '#ffffff', fontSize: '14px' };
        break;
      case 'image':
        newElement = { id, type: 'image', enabled: true, src: '', alt: '', width: '100%', height: 'auto', borderRadius: '8px', objectFit: 'cover' };
        break;
      case 'video':
        newElement = { id, type: 'video', enabled: true, src: '', autoplay: false, muted: true, loop: false, controls: true, poster: '' };
        break;
      case 'connect_button':
        newElement = { id, type: 'connect_button', enabled: true, text: 'Kết nối ngay', color: '#ffffff', bgColor: '#3b82f6', radius: '50px', showPhone: false, phonePlaceholder: 'Nhập số điện thoại', termsText: '' };
        break;
      case 'video_gate':
        newElement = { id, type: 'video_gate', enabled: true, videoUrl: '', skipAfter: 5, poster: '' };
        break;
      default:
        return;
    }
    updateConfig(prev => ({ ...prev, elements: [...prev.elements, newElement] }));
    setSelectedElementId(id);
    setActiveTab('elements');
  }, [updateConfig]);

  const handleDragStart = (index: number) => {
    setDragIndex(index);
  };

  const handleDragOver = (e: React.DragEvent, index: number) => {
    e.preventDefault();
    setDragOverIndex(index);
  };

  const handleDrop = (index: number) => {
    if (dragIndex === null || dragIndex === index) {
      setDragIndex(null);
      setDragOverIndex(null);
      return;
    }
    updateConfig(prev => {
      const elements = [...prev.elements];
      const [moved] = elements.splice(dragIndex, 1);
      elements.splice(index, 0, moved);
      return { ...prev, elements };
    });
    setDragIndex(null);
    setDragOverIndex(null);
  };

  const handleSave = () => {
    onSave(localConfig);
  };

  const selectedElement = localConfig.elements.find(el => el.id === selectedElementId);

  return (
    <div className="h-full flex flex-col bg-gray-100">
      {/* Toolbar */}
      <div className="h-14 bg-white border-b border-gray-200 flex items-center justify-between px-4 shrink-0 shadow-sm">
        <div className="flex items-center gap-2">
          <button
            onClick={() => setPreviewMode('mobile')}
            className={`p-2 rounded-lg transition-colors ${previewMode === 'mobile' ? 'bg-blue-100 text-blue-600' : 'text-gray-400 hover:text-gray-600'}`}
          >
            <Smartphone className="w-5 h-5" />
          </button>
          <button
            onClick={() => setPreviewMode('desktop')}
            className={`p-2 rounded-lg transition-colors ${previewMode === 'desktop' ? 'bg-blue-100 text-blue-600' : 'text-gray-400 hover:text-gray-600'}`}
          >
            <Monitor className="w-5 h-5" />
          </button>
        </div>
        <button
          onClick={handleSave}
          className="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-sm font-medium"
        >
          Lưu giao diện
        </button>
      </div>

      <div className="flex-1 flex overflow-hidden">
        {/* Phone Preview */}
        <div className="flex-1 flex items-start justify-center p-6 overflow-y-auto">
          <div
            className={`bg-black rounded-[40px] p-3 shadow-2xl transition-all duration-300 ${
              previewMode === 'mobile' ? 'w-[375px]' : 'w-[768px]'
            }`}
          >
            {/* Phone notch */}
            <div className="flex justify-center mb-1">
              <div className="w-24 h-5 bg-black rounded-b-2xl" />
            </div>
            {/* Phone screen */}
            <div className="bg-white rounded-[28px] overflow-hidden" style={{ minHeight: '600px', maxHeight: '700px', overflowY: 'auto' }}>
              <PhonePreview
                config={localConfig}
                selectedId={selectedElementId}
                onSelectElement={setSelectedElementId}
              />
            </div>
            {/* Phone bottom */}
            <div className="flex justify-center mt-2">
              <div className="w-10 h-10 rounded-full border-2 border-gray-600" />
            </div>
          </div>
        </div>

        {/* Right Panel */}
        <div className="w-[380px] bg-white border-l border-gray-200 flex flex-col shrink-0 overflow-hidden">
          {/* Tabs */}
          <div className="flex border-b border-gray-200 shrink-0">
            <button
              onClick={() => { setActiveTab('background'); setSelectedElementId(null); }}
              className={`flex-1 py-3 text-sm font-medium transition-colors ${
                activeTab === 'background' ? 'text-blue-600 border-b-2 border-blue-600' : 'text-gray-500 hover:text-gray-700'
              }`}
            >
              Hình nền
            </button>
            <button
              onClick={() => setActiveTab('elements')}
              className={`flex-1 py-3 text-sm font-medium transition-colors ${
                activeTab === 'elements' ? 'text-blue-600 border-b-2 border-blue-600' : 'text-gray-500 hover:text-gray-700'
              }`}
            >
              Thành phần
            </button>
          </div>

          {/* Panel Content */}
          <div className="flex-1 overflow-y-auto p-4">
            {activeTab === 'background' && (
              <BackgroundPanel config={localConfig} updateConfig={updateConfig} />
            )}
            {activeTab === 'elements' && !selectedElement && (
              <ElementListPanel
                elements={localConfig.elements}
                onSelect={setSelectedElementId}
                onToggle={toggleElement}
                onRemove={removeElement}
                onAdd={addElement}
                onDragStart={handleDragStart}
                onDragOver={handleDragOver}
                onDrop={handleDrop}
                dragOverIndex={dragOverIndex}
              />
            )}
            {activeTab === 'elements' && selectedElement && (
              <ElementEditorPanel
                element={selectedElement}
                onUpdate={updateElement}
                onBack={() => setSelectedElementId(null)}
              />
            )}
          </div>
        </div>
      </div>
    </div>
  );
}

// ============================================
// Phone Preview Component
// ============================================

function PhonePreview({
  config,
  selectedId,
  onSelectElement,
}: {
  config: TemplateConfig;
  selectedId: string | null;
  onSelectElement: (id: string) => void;
}) {
  const bg = config.background;
  const bgImage = bg.imageMobile || bg.imageDesktop;

  return (
    <div
      className="relative min-h-[600px]"
      style={{
        backgroundImage: bgImage ? `url(${bgImage})` : undefined,
        backgroundSize: bg.type || 'cover',
        backgroundPosition: 'center',
        backgroundRepeat: 'no-repeat',
        backgroundColor: bgImage ? undefined : '#1e293b',
      }}
    >
      {/* Overlay */}
      {bg.overlayOpacity > 0 && (
        <div
          className="absolute inset-0"
          style={{
            backgroundColor: bg.overlayColor,
            opacity: bg.overlayOpacity,
          }}
        />
      )}

      {/* Elements */}
      <div className="relative z-10" style={{ padding: bg.padding || '20px' }}>
        {config.elements.filter(el => el.enabled).map((el) => (
          <div
            key={el.id}
            className={`relative cursor-pointer transition-all rounded-lg ${
              selectedId === el.id
                ? 'ring-2 ring-blue-500 ring-offset-1'
                : 'hover:ring-1 hover:ring-blue-300'
            }`}
            onClick={(e) => { e.stopPropagation(); onSelectElement(el.id); }}
          >
            <PreviewElement element={el} />
          </div>
        ))}
      </div>
    </div>
  );
}

function PreviewElement({ element }: { element: TemplateElement }) {
  switch (element.type) {
    case 'logo': {
      const el = element as LogoElement;
      const justify = el.position === 'left' ? 'flex-start' : el.position === 'right' ? 'flex-end' : 'center';
      return (
        <div style={{ display: 'flex', justifyContent: justify, padding: '12px 0' }}>
          {el.src ? (
            <img src={el.src} alt="Logo" style={{ width: el.width, height: 'auto', objectFit: 'contain' }} />
          ) : (
            <div style={{ width: el.width, height: '60px', background: 'rgba(255,255,255,0.1)', border: '2px dashed rgba(255,255,255,0.3)', borderRadius: '8px', display: 'flex', alignItems: 'center', justifyContent: 'center', color: 'rgba(255,255,255,0.5)', fontSize: '12px' }}>
              LOGO
            </div>
          )}
        </div>
      );
    }
    case 'title': {
      const el = element as TitleElement;
      return (
        <div style={{ padding: '8px 0', textAlign: el.align, color: el.color, fontSize: el.fontSize, fontWeight: 700 }}>
          {el.content || 'Tiêu đề'}
        </div>
      );
    }
    case 'description': {
      const el = element as DescriptionElement;
      return (
        <div style={{ padding: '4px 0', textAlign: 'center', color: el.color, fontSize: el.fontSize }}>
          {el.content || 'Mô tả'}
        </div>
      );
    }
    case 'image': {
      const el = element as ImageElement;
      return (
        <div style={{ padding: '8px 0' }}>
          {el.src ? (
            <img src={el.src} alt={el.alt} style={{ width: el.width, height: el.height === 'auto' ? 'auto' : el.height, objectFit: el.objectFit, borderRadius: el.borderRadius, display: 'block' }} />
          ) : (
            <div style={{ width: '100%', height: '120px', background: 'rgba(255,255,255,0.1)', border: '2px dashed rgba(255,255,255,0.3)', borderRadius: el.borderRadius, display: 'flex', alignItems: 'center', justifyContent: 'center', color: 'rgba(255,255,255,0.5)', fontSize: '12px' }}>
              Chọn hình ảnh
            </div>
          )}
        </div>
      );
    }
    case 'video': {
      const el = element as VideoElement;
      return (
        <div style={{ padding: '8px 0' }}>
          {el.src ? (
            <video src={el.src} controls={el.controls} muted={el.muted} poster={el.poster || undefined} style={{ width: '100%', borderRadius: '8px' }} />
          ) : (
            <div style={{ width: '100%', height: '180px', background: 'rgba(255,255,255,0.1)', border: '2px dashed rgba(255,255,255,0.3)', borderRadius: '8px', display: 'flex', alignItems: 'center', justifyContent: 'center', color: 'rgba(255,255,255,0.5)', fontSize: '12px' }}>
              <Film className="w-8 h-8 mr-2 opacity-50" /> Chọn video
            </div>
          )}
        </div>
      );
    }
    case 'connect_button': {
      const el = element as ConnectButtonElement;
      return (
        <div style={{ padding: '12px 0' }}>
          {el.showPhone && (
            <input
              type="text"
              placeholder={el.phonePlaceholder}
              disabled
              style={{ width: '100%', padding: '12px 16px', border: '1px solid rgba(255,255,255,0.3)', borderRadius: el.radius, fontSize: '14px', marginBottom: '8px', boxSizing: 'border-box', background: 'rgba(255,255,255,0.9)', color: '#333' }}
            />
          )}
          <button
            disabled
            style={{ width: '100%', padding: '14px', background: el.bgColor, color: el.color, border: 'none', borderRadius: el.radius, fontSize: '16px', fontWeight: 600, cursor: 'pointer' }}
          >
            {el.text}
          </button>
          {el.termsText && (
            <p style={{ fontSize: '11px', color: 'rgba(255,255,255,0.6)', textAlign: 'center', marginTop: '8px' }}>
              {el.termsText}
            </p>
          )}
        </div>
      );
    }
    case 'video_gate': {
      const el = element as VideoGateElement;
      return (
        <div style={{ padding: '8px 0' }}>
          <div style={{ background: 'rgba(0,0,0,0.7)', borderRadius: '12px', padding: '16px', textAlign: 'center', color: 'white' }}>
            <PlayCircle className="w-10 h-10 mx-auto mb-2 opacity-70" />
            <p style={{ fontSize: '13px', fontWeight: 600 }}>Video Gate</p>
            <p style={{ fontSize: '11px', opacity: 0.7 }}>Xem video {el.skipAfter}s trước khi kết nối</p>
          </div>
        </div>
      );
    }
    default:
      return null;
  }
}

// ============================================
// Background Panel
// ============================================

function BackgroundPanel({
  config,
  updateConfig,
}: {
  config: TemplateConfig;
  updateConfig: (fn: (prev: TemplateConfig) => TemplateConfig) => void;
}) {
  const bg = config.background;

  const updateBg = (updates: Partial<TemplateConfig['background']>) => {
    updateConfig(prev => ({ ...prev, background: { ...prev.background, ...updates } }));
  };

  return (
    <div className="space-y-5">
      <h3 className="text-sm font-semibold text-gray-700">Cài đặt hình nền</h3>

      <MediaUploadField
        label="Hình nền mobile"
        value={bg.imageMobile || ''}
        onChange={(v) => updateBg({ imageMobile: v })}
        accept="image/*"
      />

      <MediaUploadField
        label="Hình nền máy tính"
        value={bg.imageDesktop || ''}
        onChange={(v) => updateBg({ imageDesktop: v })}
        accept="image/*"
      />

      <div>
        <label className="block text-xs font-medium text-gray-600 mb-1">Kiểu nền</label>
        <select
          value={bg.type}
          onChange={(e) => updateBg({ type: e.target.value as 'cover' | 'contain' | 'fill' })}
          className="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          <option value="cover">Phủ toàn bộ (Cover)</option>
          <option value="contain">Vừa khung (Contain)</option>
          <option value="fill">Kéo giãn (Fill)</option>
        </select>
      </div>

      <div>
        <label className="block text-xs font-medium text-gray-600 mb-1">Màu phủ</label>
        <div className="flex items-center gap-2">
          <input
            type="color"
            value={bg.overlayColor}
            onChange={(e) => updateBg({ overlayColor: e.target.value })}
            className="w-10 h-10 rounded-lg border-0 cursor-pointer"
          />
          <input
            type="text"
            value={bg.overlayColor}
            onChange={(e) => updateBg({ overlayColor: e.target.value })}
            className="flex-1 px-3 py-2 border border-gray-200 rounded-lg text-sm font-mono"
          />
        </div>
      </div>

      <div>
        <label className="block text-xs font-medium text-gray-600 mb-1">
          Độ trong suốt màu phủ: {Math.round(bg.overlayOpacity * 100)}%
        </label>
        <input
          type="range"
          min="0"
          max="100"
          value={Math.round(bg.overlayOpacity * 100)}
          onChange={(e) => updateBg({ overlayOpacity: parseInt(e.target.value) / 100 })}
          className="w-full"
        />
      </div>

      <div>
        <label className="block text-xs font-medium text-gray-600 mb-1">Khoảng đệm (padding)</label>
        <input
          type="text"
          value={bg.padding}
          onChange={(e) => updateBg({ padding: e.target.value })}
          className="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm"
          placeholder="20px"
        />
      </div>
    </div>
  );
}

// ============================================
// Element List Panel
// ============================================

function ElementListPanel({
  elements,
  onSelect,
  onToggle,
  onRemove,
  onAdd,
  onDragStart,
  onDragOver,
  onDrop,
  dragOverIndex,
}: {
  elements: TemplateElement[];
  onSelect: (id: string) => void;
  onToggle: (id: string) => void;
  onRemove: (id: string) => void;
  onAdd: (type: TemplateElement['type']) => void;
  onDragStart: (index: number) => void;
  onDragOver: (e: React.DragEvent, index: number) => void;
  onDrop: (index: number) => void;
  dragOverIndex: number | null;
}) {
  const [showAddMenu, setShowAddMenu] = useState(false);

  const addableTypes: { type: TemplateElement['type']; label: string }[] = [
    { type: 'logo', label: 'Logo' },
    { type: 'title', label: 'Tiêu đề' },
    { type: 'description', label: 'Mô tả' },
    { type: 'image', label: 'Hình ảnh' },
    { type: 'video', label: 'Video' },
    { type: 'connect_button', label: 'Nút kết nối' },
    { type: 'video_gate', label: 'Video Gate' },
  ];

  return (
    <div className="space-y-3">
      <div className="flex items-center justify-between">
        <h3 className="text-sm font-semibold text-gray-700">Danh sách thành phần</h3>
        <div className="relative">
          <button
            onClick={() => setShowAddMenu(!showAddMenu)}
            className="p-1.5 rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-100 transition-colors"
          >
            <Plus className="w-4 h-4" />
          </button>
          {showAddMenu && (
            <div className="absolute right-0 top-full mt-1 w-48 bg-white rounded-lg shadow-lg border border-gray-200 z-10 py-1">
              {addableTypes.map(({ type, label }) => (
                <button
                  key={type}
                  onClick={() => { onAdd(type); setShowAddMenu(false); }}
                  className="w-full text-left px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 flex items-center gap-2"
                >
                  {ELEMENT_ICONS[type]}
                  {label}
                </button>
              ))}
            </div>
          )}
        </div>
      </div>

      <p className="text-xs text-gray-400">Kéo thả để sắp xếp thứ tự. Bấm để chỉnh sửa.</p>

      <div className="space-y-1">
        {elements.map((el, index) => (
          <div
            key={el.id}
            draggable
            onDragStart={() => onDragStart(index)}
            onDragOver={(e) => onDragOver(e, index)}
            onDrop={() => onDrop(index)}
            onDragEnd={() => { }}
            className={`flex items-center gap-2 p-2.5 rounded-lg border transition-all cursor-pointer ${
              dragOverIndex === index ? 'border-blue-400 bg-blue-50' : 'border-gray-200 bg-white hover:border-gray-300'
            } ${!el.enabled ? 'opacity-50' : ''}`}
          >
            <div className="cursor-grab text-gray-400 hover:text-gray-600">
              <GripVertical className="w-4 h-4" />
            </div>
            <div
              className="flex-1 flex items-center gap-2 min-w-0"
              onClick={() => onSelect(el.id)}
            >
              <span className="text-gray-500">{ELEMENT_ICONS[el.type]}</span>
              <span className="text-sm font-medium text-gray-700 truncate">
                {ELEMENT_LABELS[el.type] || el.type}
              </span>
            </div>
            <button
              onClick={(e) => { e.stopPropagation(); onToggle(el.id); }}
              className="p-1 rounded text-gray-400 hover:text-gray-600"
              title={el.enabled ? 'Ẩn' : 'Hiện'}
            >
              {el.enabled ? <Eye className="w-3.5 h-3.5" /> : <EyeOff className="w-3.5 h-3.5" />}
            </button>
            <button
              onClick={(e) => { e.stopPropagation(); onRemove(el.id); }}
              className="p-1 rounded text-gray-400 hover:text-red-500"
              title="Xóa"
            >
              <Trash2 className="w-3.5 h-3.5" />
            </button>
          </div>
        ))}
      </div>
    </div>
  );
}

// ============================================
// Element Editor Panel
// ============================================

function ElementEditorPanel({
  element,
  onUpdate,
  onBack,
}: {
  element: TemplateElement;
  onUpdate: (id: string, updates: Partial<TemplateElement>) => void;
  onBack: () => void;
}) {
  return (
    <div className="space-y-4">
      <button
        onClick={onBack}
        className="text-sm text-blue-600 hover:text-blue-700 font-medium flex items-center gap-1"
      >
        ← Quay lại danh sách
      </button>
      <h3 className="text-sm font-semibold text-gray-700">
        Chỉnh sửa: {ELEMENT_LABELS[element.type]}
      </h3>

      {element.type === 'logo' && <LogoEditor element={element as LogoElement} onUpdate={onUpdate} />}
      {element.type === 'title' && <TitleEditor element={element as TitleElement} onUpdate={onUpdate} />}
      {element.type === 'description' && <DescriptionEditor element={element as DescriptionElement} onUpdate={onUpdate} />}
      {element.type === 'image' && <ImageEditor element={element as ImageElement} onUpdate={onUpdate} />}
      {element.type === 'video' && <VideoEditor element={element as VideoElement} onUpdate={onUpdate} />}
      {element.type === 'connect_button' && <ConnectButtonEditor element={element as ConnectButtonElement} onUpdate={onUpdate} />}
      {element.type === 'video_gate' && <VideoGateEditor element={element as VideoGateElement} onUpdate={onUpdate} />}
    </div>
  );
}

// ============================================
// Individual Element Editors
// ============================================

function LogoEditor({ element, onUpdate }: { element: LogoElement; onUpdate: (id: string, u: Partial<LogoElement>) => void }) {
  return (
    <div className="space-y-4">
      <MediaUploadField
        label="Ảnh logo"
        value={element.src}
        onChange={(v) => onUpdate(element.id, { src: v })}
        accept="image/*"
      />
      <div>
        <label className="block text-xs font-medium text-gray-600 mb-1">Chiều rộng</label>
        <input type="text" value={element.width} onChange={(e) => onUpdate(element.id, { width: e.target.value })}
          className="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" placeholder="120px" />
      </div>
      <div>
        <label className="block text-xs font-medium text-gray-600 mb-1">Vị trí</label>
        <select value={element.position} onChange={(e) => onUpdate(element.id, { position: e.target.value as 'left' | 'center' | 'right' })}
          className="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm">
          <option value="left">Bên trái</option>
          <option value="center">Ở giữa</option>
          <option value="right">Bên phải</option>
        </select>
      </div>
    </div>
  );
}

