{
  "name": "wifimarketing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "APP_SERVER_MODE=frontend PORT=3000 next dev -H 0.0.0.0",
    "dev:backend": "APP_SERVER_MODE=backend PORT=3001 next dev -H 0.0.0.0",
    "build": "next build",
    "start": "npm run start:frontend",
    "start:frontend": "APP_SERVER_MODE=frontend PORT=3000 next start -H 0.0.0.0",
    "start:backend": "APP_SERVER_MODE=backend PORT=3001 next start -H 0.0.0.0",
    "start:all": "sh -c 'npm run start:backend & npm run start:frontend'",
    "lint": "next lint",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.38.0",
    "grapesjs": "^0.21.13",
    "grapesjs-preset-webpage": "^1.0.3",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.400.0",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "sharp": "^0.33.4",
    "swiper": "^11.1.4",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/exceljs": "^0.5.3",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.1.9"
  }
}
