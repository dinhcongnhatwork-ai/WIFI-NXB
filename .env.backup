# ===========================================
# WiFi Marketing Platform - Environment Config
# ===========================================

# Public domain and ports
APP_DOMAIN=wifi.jtsc.vn
FRONTEND_PORT=3000
BACKEND_PORT=3001
BACKEND_URL=http://127.0.0.1:3001

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:jtsc12345@192.168.1.90:5432/wifimarketing?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# MinIO (S3-compatible storage)
MINIO_ENDPOINT="https://jtscminio.duckdns.org"
MINIO_PUBLIC_URL="https://jtscminio.duckdns.org"
MINIO_ACCESS_KEY=jtsc
MINIO_SECRET_KEY=jtsc12345
MINIO_BUCKET=wifimarketing

# JWT Authentication
JWT_SECRET="10122002"

# ===========================================
# MikroTik RouterOS Configuration
# ===========================================
MIKROTIK_HOST=192.168.1.200
MIKROTIK_USERNAME=admin
MIKROTIK_PASSWORD=123456
MIKROTIK_TIMEOUT_MS=12000
MIKROTIK_ALLOW_INSECURE=true
HOTSPOT_DNS_NAME=hotspot.wifi

# Backward compatibility (old key)
MIKROTIK_IP=192.168.1.200

# Next.js
NEXT_PUBLIC_APP_URL=https://wifi.jtsc.vn
NEXT_PUBLIC_API_URL=https://wifi.jtsc.vn

# ===========================================
